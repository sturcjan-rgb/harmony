{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "harmony/rozvrh",
  "title": "Rozvrh Harmony",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "Živý rozvrh lekcí z memberzone.",
  "keywords": ["rozvrh", "lekce", "memberzone"],
  "textdomain": "harmony-rozvrh",
  "attributes": {
    "tydny": { "type": "number", "default": 3 },
    "filtry": { "type": "boolean", "default": true }
  },
  "supports": { "html": false, "align": ["wide", "full"] },
  "editorScript": "file:./index.js",
  "style": "harmony-rozvrh"
}
